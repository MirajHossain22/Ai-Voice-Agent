{
  "name": "@ai-voice-agent/backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit false --outDir dist",
    "start": "tsx src/server.ts",
    "start:prod": "node dist/server.js",
    "test": "vitest run",
    "db:generate": "prisma generate --config prisma.generate.config.ts",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.8",
    "fastify": "5.12.7",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/pg": "8.23.1",
    "prisma": "7.10.1",
    "typescript": "5.9.3",
    "tsx": "4.23.15",
    "vitest": "5.0.5"
  }
}
