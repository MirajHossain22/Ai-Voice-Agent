DATABASE_URL=postgresql://ai_voice_agent:ai_voice_agent@localhost:5432/ai_voice_agent
HOST=127.0.0.1
PORT=3000
NODE_ENV=development
RECORDING_NOTICE=This call may be recorded and processed by AI.
DASHBOARD_TOKEN=replace-with-a-dashboard-secret
DASHBOARD_ORIGIN=http://127.0.0.1:5173
VAPI_WEBHOOK_TOKEN=replace-with-a-secret-token
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIME_ZONE=UTC
GOOGLE_OAUTH_CLIENT_ID=replace-with-google-oauth-client-id
GOOGLE_OAUTH_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_OAUTH_REFRESH_TOKEN=replace-with-google-oauth-refresh-token
GOOGLE_CALENDAR_TIMEOUT_MS=5000
GOOGLE_CALENDAR_RETRIES=2
HUBSPOT_ENABLED=false
HUBSPOT_ACCESS_TOKEN=replace-with-hubspot-private-app-token
HUBSPOT_TIMEOUT_MS=5000
HUBSPOT_RETRIES=2
RESEND_ENABLED=false
RESEND_API_KEY=replace-with-resend-api-key
